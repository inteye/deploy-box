DEPLOY_CONSOLE_SECRET_KEY=replace-me-in-production
DEPLOY_CONSOLE_ADMIN_USERNAME=admin
DEPLOY_CONSOLE_ADMIN_PASSWORD=change-me-now

# 这里填宿主机上的统一工作区根目录，容器会把它挂载到 /workspace
# 多项目场景建议把所有待发布项目聚合到这个目录下
# 可以放真实目录，也可以放管理员预先创建好的软链接
# 例如：
#   /srv/deploy-workspace/project-a -> /data/repos/project-a
#   /srv/deploy-workspace/project-b -> /opt/apps/project-b
DEPLOY_CONSOLE_WORKSPACE_HOST_PATH=/absolute/path/to/deploy-workspace

# 容器内统一工作区根，通常保持默认即可
DEPLOY_CONSOLE_WORKSPACE_PATH=/workspace

# 项目默认打包脚本，相对于“项目工作区路径”
DEPLOY_CONSOLE_PACKAGE_SCRIPT=deploy/scripts/package_release.sh

# 本地制品站
DEPLOY_CONSOLE_PORT=18101
DEPLOY_CONSOLE_ARTIFACTS_PORT=18081
DEPLOY_CONSOLE_PACKAGE_ARTIFACT_BASE_URL=http://artifacts/releases
DEPLOY_CONSOLE_LOCAL_ARTIFACTS_PATH=/artifacts/releases

# 这里建议填写宿主机实际可访问的 IP 或域名，不要默认依赖 host.docker.internal
# 例如：
# DEPLOY_CONSOLE_PACKAGE_ARTIFACT_PUBLIC_BASE_URL=http://192.168.1.10:18081/releases
DEPLOY_CONSOLE_PACKAGE_ARTIFACT_PUBLIC_BASE_URL=http://host.docker.internal:18081/releases

# 可选：使用 OSS 时打开
USE_OSS=false
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET_NAME=
OSS_REGION=
OSS_ENDPOINT=
OSS_CUSTOM_DOMAIN=
